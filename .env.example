GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SERPER_API_KEY=your-serper-api-key
# Optional DDGS metasearch settings; no API key is required.
DDGS_REGION=wt-wt
DDGS_BACKEND=auto
# Network timeout for individual external requests.
SIDEKICK_REQUEST_TIMEOUT=10
PUSHOVER_TOKEN=your-pushover-application-token
PUSHOVER_USER=your-pushover-user-key

# Runtime model routing (providers without keys are skipped). A rate-limited
# model is skipped for the rest of the active task; order is left to right.
SIDEKICK_GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
SIDEKICK_GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
SIDEKICK_OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,cohere/north-mini-code:free
SIDEKICK_PROVIDER_ORDER=gemini,groq,openrouter

# Optional LangSmith observability.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=sidekick

# Optional commit proposal configuration.
GEMINI_COMMIT_MODELS=
GROQ_COMMIT_MODEL=openai/gpt-oss-120b
OPENROUTER_COMMIT_MODEL=openai/gpt-oss-120b
COMMIT_GENERATION_TIMEOUT=15
